{
  "name": "nerdy-vscode",
  "displayName": "Nerdy",
  "description": "Nerd glyph picker for VS Code",
  "version": "1.0.0",
  "publisher": "2kabhishek",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/2kabhishek/nerdy-vscode"
  },
  "homepage": "https://github.com/2kabhishek/nerdy-vscode",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Utilities"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nerdy.insertIcon",
        "title": "Nerdy: Insert Icon"
      },
      {
        "command": "nerdy.insertRecentIcon",
        "title": "Nerdy: Insert Recent Icon"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vscode-test",
    "update-glyphs": "ts-node scripts/updateGlyphs.ts",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.9.0",
    "@types/vscode": "^1.110.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.6"
    }
  },
  "packageManager": "pnpm@8.15.3+sha1.64838798f519c18029c1e8a1310e16101fc2eda0"
}
